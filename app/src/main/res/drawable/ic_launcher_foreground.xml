<!-- Adaptive-icon foreground: the Valoo "V" mark, sized into the 108dp safe zone.
     The green tile is supplied by the adaptive-icon background layer.
     The left arm is white; the right arm is amber and rises past it into an
     up-arrow — a "V" that reads as value going up. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Left arm of the V (white), meeting the bottom point. -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="13"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M34,34 L54,76" />

    <!-- Right arm (amber): rises from the bottom point up past the left arm. -->
    <path
        android:strokeColor="#F9A825"
        android:strokeWidth="13"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M54,76 L80,28" />

    <!-- Arrowhead at the top of the right arm, pointing up-right. -->
    <path
        android:strokeColor="#F9A825"
        android:strokeWidth="9"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M66,30 L80,28 L78,44" />
</vector>
